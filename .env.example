# ============================================================================
# GALI — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# --- Sectors Financial API -------------------------------------------------
# Obtain from https://sectors.app -> API page -> API Keys (Insider plan).
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app

# Hard ceiling on lifetime credit spend. The hackathon grant is 1000; we stop
# at 950 so a runaway job can never exhaust the grant. See docs/CREDIT_BUDGET.md
SECTORS_CREDIT_HARD_CAP=950

# When 1, SectorsClient serves exclusively from raw.responses and raises on any
# cache miss instead of spending a credit. Default mode during development.
GALI_DRY_RUN=1

# --- Database --------------------------------------------------------------
# Local dev (docker compose). Production: Neon pooled connection string.
DATABASE_URL=postgresql+asyncpg://gali:gali@localhost:5433/gali
DATABASE_URL_SYNC=postgresql+psycopg://gali:gali@localhost:5433/gali

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_KEYED_PER_MIN=600
LOG_LEVEL=INFO

# --- Observability (optional in dev) ---------------------------------------
SENTRY_DSN=
ENVIRONMENT=development

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
